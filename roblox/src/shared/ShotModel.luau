-- Probability that the hitting team wins the rally.
function M.predict(x)
	local s = 0
	for _, tr in TREES do
		local n, f, t, l, r = tr.root, tr.f, tr.t, tr.l, tr.r
		while n > 0 do
			if x[f[n]] <= t[n] then n = l[n] else n = r[n] end
		end
		s += tr.v[1 - n]
	end
	return 1 / (1 + math.exp(-s))
end

return M
