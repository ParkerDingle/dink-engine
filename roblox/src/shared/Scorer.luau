--!nocheck
-- Re-scores rule-engine options with the trained shot-value model (ShotModel.luau, generated by
-- ml/dink_ml/export_luau.py). Falls back to the rule engine if the model's feature version differs.
local function req(name) if script then return require(script.Parent[name]) else return require("./" .. name) end end
local R = req("Rules")
local F = req("Features")
local ok, Model = pcall(req, "ShotModel")

local S = {}
S.enabled = ok and Model and Model.featureVersion == F.VERSION
S.info = if S.enabled then Model.info else nil

function S.evaluate(state)
	local opts = R.evaluate(state)
	if not S.enabled then return opts, false end
	for _, o in opts do
		o.ruleP = o.P
		o.P = Model.predict(F.featuresFor(state, o.type, o.target))
	end
	return R.sortOptions(opts), true
end

return S
